# ---- 服务 ----
NODE_ENV=development
PORT=8787

# ---- 安全（生产必须改）----
# 生成：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=dev-only-insecure-secret-change-me
ACCESS_TTL_SEC=7200
REFRESH_TTL_SEC=2592000

# ---- 时间 ----
DEFAULT_TZ_OFFSET=+08:00

# ---- 微信小程序（不填 = 开发模式：code 直接映射 openid，不调微信）----
WECHAT_APPID=
WECHAT_SECRET=
# 图片内容安全（需上面凭据；未配置时上传一律 approved）
IMAGE_CHECK_ENABLED=false
# 强制微信 code 一次性（生产 true；本地调试关掉可复用同一 code）
STRICT_WECHAT_CODES=false

# ---- 存储 ----
# 照片落盘目录（生产换对象存储 + CDN，见 README）
STORAGE_DIR=var/uploads
# 照片 URL 前缀（主机根，不含 /v1）
PUBLIC_BASE_URL=http://localhost:8787
# 存储后端：memory（纯内存，重启即丢，仅测试/本地） | sqlite（单文件，单机生产推荐）
STORAGE=memory
# SQLite 数据库文件（STORAGE=sqlite 时生效）
SQLITE_FILE=var/db.sqlite
PHOTO_MAX_BYTES=10485760
# 预置图目录（12 张预置菜品图 + 2 张分享封面）。
# 什么时候需要它：前端设了 TARO_APP_ASSET_BASE 指向本服务时，会把
#   /static/img/kaoya.jpg 拍平成 <ASSET_BASE>/kaoya.jpg 来取图（主包因此只有 472.7 KB）。
# 不配也行 —— 会按 workspace 布局自动探测（见 src/lib/preset-assets.ts）。
# 生产推荐显式指到挂载盘，例如 /srv/photo-wall/presets。
PRESET_ASSET_DIR=

# ---- 行为 ----
# 新用户是否注入 12 条示例记录（默认关：AC-01 要求新用户 recordCount=0）
SEED_DEMO_RECORDS=false
RESTORE_WINDOW_DAYS=30
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=60
RATE_LIMIT_PHOTO=20
RATE_LIMIT_AUTH=10
SERVE_DOCS=true
APP_VERSION=1.0.0

# ---- 反向代理（限流分组的正确性依赖它）----
# false（默认，直连公网）：限流按 TCP 对端 IP 分组，客户端伪造
#   X-Forwarded-For 无效。
# true（部署在 Nginx/Caddy 之后）：按 X-Forwarded-For 的**最右一跳**分组
#   （最左段由客户端控制，不可信）。
# ⚠ 直连公网却打开它 = 限流形同虚设：换个假 IP 就绕过。
TRUST_PROXY=false
