{
  "name": "@photo-wall/ui-taro",
  "version": "1.0.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "X师傅美食记 · 照片墙（Taro 小程序 + H5）",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "build:weapp": "taro build --type weapp",
    "build:h5": "taro build --type h5",
    "dev:weapp": "npm run build:weapp -- --watch",
    "dev:h5": "npm run build:h5 -- --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-test-module-mocks test/*.test.ts",
    "e2e": "node tools/run-e2e.mjs",
    "e2e:install": "playwright install chromium",
    "size": "node tools/check-size.mjs",
    "sync:contract": "node tools/sync-contract.mjs",
    "compress:img": "python tools/compress-presets.py"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 4.1",
    "ios >= 8"
  ],
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@photo-wall/core": "1.0.0",
    "@tarojs/components": "4.3.0",
    "@tarojs/helper": "4.3.0",
    "@tarojs/plugin-framework-react": "4.3.0",
    "@tarojs/plugin-platform-h5": "4.3.0",
    "@tarojs/plugin-platform-weapp": "4.3.0",
    "@tarojs/react": "4.3.0",
    "@tarojs/router": "4.3.0",
    "@tarojs/runtime": "4.3.0",
    "@tarojs/shared": "4.3.0",
    "@tarojs/taro": "4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/preset-react": "^7.29.7",
    "@playwright/test": "1.62.0",
    "@tarojs/cli": "^4.3.0",
    "@tarojs/webpack5-runner": "4.3.0",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "babel-preset-taro": "4.3.0",
    "js-yaml": "^4.3.2",
    "postcss": "^8.4.49",
    "sass": "1.80.0",
    "typescript": "^5.6.3",
    "webpack": "5.91.0"
  }
}
